 "characters": [
  {
   "id": "harvey-cheyne",
   "name": "Harvey Cheyne",
   "aliases": [
    "Harvey"
   ],
   "role": "protagonist",
   "group": "g-cheyne",
   "firstAppearance": "s1",
   "summary": "First mention: “\"Shut the door, Harvey,\" said the New Yorker.”"
  },
  {
   "id": "dan",
   "name": "Dan",
   "role": "protagonist",
   "firstAppearance": "s1",
   "summary": "First mention: “I'm his son,--Dan, they call me,--an' I'm cook's helper an' everything else aboard that's too dirty for the men.”"
  },
  {
   "id": "disko-troop",
   "name": "Disko Troop",
   "aliases": [
    "Disko",
    "Troop"
   ],
   "role": "major",
   "firstAppearance": "s1",
   "summary": "First mention: “In the second, it's annoyin' to my feelin's--an' I'm Disko Troop o' the _We're Here_ o' Gloucester, which you don't seem rightly to know.\"”"
  },
  {
   "id": "uncle-salters",
   "name": "Uncle Salters",
   "aliases": [
    "Salters"
   ],
   "role": "major",
   "firstAppearance": "s2",
   "summary": "First mention: “He's my uncle,--Dad's own brother,--an' ef there's any bad luck loose on the Banks she'll fetch up agin Uncle Salters, sure.”"
  },
  {
   "id": "tom-platt",
   "name": "Tom Platt",
   "role": "major",
   "firstAppearance": "s2",
   "summary": "First mention: “North, away yonder--you'll hear him tune up in a minute is Tom Platt.”"
  },
  {
   "id": "penn",
   "name": "Penn",
   "role": "major",
   "firstAppearance": "s2",
   "summary": "First mention: “\"You count keerful, Penn.\"”"
  },
  {
   "id": "dad",
   "name": "Dad",
   "role": "supporting",
   "firstAppearance": "s1",
   "summary": "First mention: “Dad wants to see you.”"
  },
  {
   "id": "harve",
   "name": "Harve",
   "role": "supporting",
   "firstAppearance": "s2",
   "summary": "First mention: “\"Look by your foot, Harve,\" cried Dan below.”"
  },
  {
   "id": "manuel",
   "name": "Manuel",
   "role": "supporting",
   "firstAppearance": "s1",
   "summary": "First mention: “\"You are with me in the dory--Manuel my name, and I come from schooner _We're Here_ of Gloucester.”"
  },
  {
   "id": "mrs-cheyne",
   "name": "Mrs. Cheyne",
   "role": "supporting",
   "group": "g-cheyne",
   "firstAppearance": "s1",
   "summary": "First mention: “Mrs.”"
  },
  {
   "id": "danny",
   "name": "Danny",
   "role": "minor",
   "firstAppearance": "s2",
   "summary": "First mention: “Danny, my son, clean for me.\"”"
  },
  {
   "id": "jack",
   "name": "Jack",
   "role": "minor",
   "firstAppearance": "s2",
   "summary": "First mention: “Here's Long Jack.\"”"
  },
  {
   "id": "miss-kinzey",
   "name": "Miss Kinzey",
   "role": "minor",
   "firstAppearance": "s9",
   "summary": "First mention: “\"About the only medical statement in novels with any truth to it is that joy don't kill, Miss Kinzey.\"”"
  },
  {
   "id": "frenchman",
   "name": "Frenchman",
   "role": "minor",
   "firstAppearance": "s1",
   "summary": "First mention: “We've shaved three dories an' near scalped the boom off a Frenchman since noon, an' that's close sailing', ye may say.\"”"
  },
  {
   "id": "jonah",
   "name": "Jonah",
   "role": "minor",
   "firstAppearance": "s2",
   "summary": "First mention: “\"I heard ye talkin' to Dad, an' I ha'af looked you'd be swallered up, same's Jonah.\"”"
  },
  {
   "id": "ireson",
   "name": "Ireson",
   "role": "minor",
   "firstAppearance": "s4",
   "summary": "First mention: “Tom Platt followed with something about \"the rough and tough McGinn, who would pilot the vessel in.\" Then they called on Harvey, who felt very flattered, to contribute to the entertainment; but all that he could remem…”"
  },
  {
   "id": "portuguese",
   "name": "Portuguese",
   "role": "minor",
   "firstAppearance": "s2",
   "summary": "First mention: “\"Twenty-fife father,\" said the Portuguese, sleepily.”"
  },
  {
   "id": "hattie",
   "name": "Hattie",
   "role": "minor",
   "firstAppearance": "s3",
   "summary": "First mention: “A little red dory, labelled Hattie S., lay astern of the schooner.”"
  },
  {
   "id": "johnstown",
   "name": "Johnstown",
   "role": "minor",
   "firstAppearance": "s3",
   "summary": "First mention: “You've heered talk o' Johnstown?\"”"
  },
  {
   "id": "wouverman",
   "name": "Wouverman",
   "role": "minor",
   "firstAppearance": "s8",
   "summary": "First mention: “\"Wouverman's waiting fer you, Disko.”"
  },
  {
   "id": "le",
   "name": "Le",
   "role": "minor",
   "firstAppearance": "s1",
   "summary": "First mention: “There's a heap as you can do, for Otto he went overboard on Le Have.”"
  },
  {
   "id": "marblehead",
   "name": "Marblehead",
   "role": "minor",
   "firstAppearance": "s4",
   "summary": "First mention: “I have no special call to right any Marblehead man, but 'tweren't no fault o' Ireson's.”"
  },
  {
   "id": "georges",
   "name": "Georges",
   "role": "minor",
   "firstAppearance": "s4",
   "summary": "First mention: “Jim Bourke was one till he was drowned on Georges.”"
  },
  {
   "id": "mr-cheyne",
   "name": "Mr. Cheyne",
   "role": "minor",
   "group": "g-cheyne",
   "firstAppearance": "s9",
   "summary": "First mention: “\"I don't mind ownin' to you, Mr.”"
  },
  {
   "id": "jason",
   "name": "Jason",
   "role": "minor",
   "firstAppearance": "s7",
   "summary": "First mention: “\"Oh, that don't make no odds,\" said Jason, wringing the wet from his beard.”"
  },
  {
   "id": "otto",
   "name": "Otto",
   "role": "minor",
   "firstAppearance": "s1",
   "summary": "First mention: “There ain't no boy here 'cep' me sence Otto went overboard--an' he was only a Dutchy, an' twenty year old at that.”"
  },
  {
   "id": "st-malo",
   "name": "St. Malo",
   "role": "minor",
   "firstAppearance": "s5",
   "summary": "First mention: “\"Miquelon boat from St.”"
