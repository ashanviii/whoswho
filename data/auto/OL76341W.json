  {
   "id": "kalon",
   "name": "Kalon",
   "role": "supporting",
   "firstAppearance": "s10",
   "summary": "First mention: “The fact is that a fellow calling himself Kalon (I don’t know what his name is, except that it can’t be that) has taken the flat just above me.”"
  },
  {
   "id": "olivier",
   "name": "Olivier",
   "role": "supporting",
   "firstAppearance": "s11",
   "summary": "First mention: “It knows that after splendid yet careful campaigns both in India and Africa he was in command against Brazil when the great Brazilian patriot Olivier issued his ultimatum.”"
  },
  {
   "id": "patrick-royce",
   "name": "Patrick Royce",
   "aliases": [
    "Royce"
   ],
   "role": "supporting",
   "firstAppearance": "s12",
   "summary": "First mention: “A few more bewildered moments brought out a big fair-bearded man, whom some travellers could salute as the dead man’s secretary, Patrick Royce, once well known in Bohemian society and even famous in the Bohemian arts.”"
  },
  {
   "id": "gilder",
   "name": "Gilder",
   "role": "supporting",
   "firstAppearance": "s12",
   "summary": "First mention: “Merton’s official superior, a grizzled and capable detective named Gilder, was standing on the green bank waiting for the coroner, talking to Patrick Royce, whose big shoulders and bristly beard and hair towered above…”"
  },
  {
