   ],
   "role": "minor",
   "firstAppearance": "s7",
   "summary": "First mention: ““In that case, Dr.”"
  },
  {
   "id": "armstrong",
   "name": "Armstrong",
   "role": "minor",
   "firstAppearance": "s12",
   "summary": "First mention: “Who would kill such a cheery old chap as Armstrong?”"
  },
  {
   "id": "crook",
   "name": "Crook",
   "role": "minor",
   "firstAppearance": "s4",
   "summary": "First mention: ““Whichever side you are on,” said the young man named Crook.”"
  },
  {
   "id": "pauline",
   "name": "Pauline",
   "role": "minor",
   "firstAppearance": "s10",
   "summary": "First mention: “Not only is it true that Pauline loved me, but it is also true that this very morning, before she died, she wrote at that table a will leaving me and my new church half a million.”"
  }
