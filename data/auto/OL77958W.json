  {
   "id": "s1",
   "label": "Ch. 1",
   "title": "“Mine ear is open, and my heart prepared:"
  },
  {
   "id": "s2",
   "label": "Ch. 2",
   "title": "“Sola, sola, wo ha, ho, sola!”"
  },
  {
   "id": "s3",
   "label": "Ch. 3"
  },
  {
   "id": "s4",
   "label": "Ch. 4",
   "title": "“Well go thy way: thou shalt not from this grove"
  },
  {
   "id": "s5",
   "label": "Ch. 5",
   "title": "...”In such a night"
  },
  {
   "id": "s6",
   "label": "Ch. 6"
  },
  {
   "id": "s7",
   "label": "Ch. 7"
  },
  {
