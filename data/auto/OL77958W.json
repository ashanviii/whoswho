 "characters": [
  {
   "id": "heyward",
   "name": "Heyward",
   "aliases": [
    "Major Heyward"
   ],
   "role": "protagonist",
   "firstAppearance": "s2",
   "summary": "First mention: ““Are such specters frequent in the woods, Heyward, or is this sight an especial entertainment ordered on our behalf?”"
  },
  {
   "id": "duncan",
   "name": "Duncan",
   "role": "protagonist",
   "firstAppearance": "s2",
   "summary": "First mention: ““You know him, Duncan, or you would not trust yourself so freely to his keeping?””"
  },
  {
   "id": "uncas",
   "name": "Uncas",
   "role": "protagonist",
   "firstAppearance": "s3",
   "summary": "First mention: “I am on the hilltop and must go down into the valley; and when Uncas follows in my footsteps there will no longer be any of the blood of the Sagamores, for my boy is the last of the Mohicans.””"
  },
  {
   "id": "hawkeye",
   "name": "Hawkeye",
   "role": "major",
   "firstAppearance": "s3",
   "summary": "First mention: ““Is there no difference, Hawkeye, between the stone-headed arrow of the warrior, and the leaden bullet with which you kill?””"
  },
  {
   "id": "magua",
   "name": "Magua",
   "role": "major",
   "firstAppearance": "s4",
   "summary": "First mention: ““You may see, Magua,” he said, endeavoring to assume an air of freedom and confidence, “that the night is closing around us, and yet we are no nearer to William Henry than when we left the encampment of Webb with the…”"
  },
  {
   "id": "cora",
   "name": "Cora",
   "role": "major",
   "firstAppearance": "s2",
   "summary": "First mention: “If the latter, gratitude must close our mouths; but if the former, both Cora and I shall have need to draw largely on that stock of hereditary courage which we boast, even before we are made to encounter the redoubtab…”"
  },
  {
   "id": "alice",
   "name": "Alice",
   "role": "major",
   "firstAppearance": "s2",
   "summary": "First mention: ““Say, rather, Alice, that I would not trust you.”"
  },
  {
   "id": "david",
   "name": "David",
   "role": "major",
   "firstAppearance": "s2",
   "summary": "First mention: “I am thankful that, though my boyhood may be said to have been set apart, like the youth of the royal David, for the purposes of music, no syllable of rude verse has ever profaned my lips.””"
  },
  {
   "id": "hurons",
   "name": "Hurons",
   "role": "major",
   "firstAppearance": "s8",
   "summary": "First mention: ““Surely, surely, our case is not so desperate!” exclaimed the youth; “the Hurons are not here; we may make good the caverns, we may oppose their landing.””"
  },
  {
   "id": "munro",
   "name": "Munro",
   "role": "major",
   "firstAppearance": "s1",
   "summary": "First mention: “The news had been brought, toward the decline of a day in midsummer, by an Indian runner, who also bore an urgent request from Munro, the commander of a work on the shore of the “holy lake,” for a speedy and powerful…”"
  },
  {
   "id": "chingachgook",
   "name": "Chingachgook",
   "role": "supporting",
   "firstAppearance": "s3",
   "summary": "First mention: ““Even your traditions make the case in my favor, Chingachgook,” he said, speaking in the tongue which was known to all the natives who formerly inhabited the country between the Hudson and the Potomac, and of which we…”"
  },
  {
   "id": "indians",
   "name": "Indians",
   "role": "supporting",
   "firstAppearance": "s1",
   "summary": "First mention: “[1] As each nation of the Indians had its language or its dialect, they usually gave different names to the same places, though nearly all of their appellations were descriptive of the object.”"
  },
  {
   "id": "montcalm",
   "name": "Montcalm",
   "role": "supporting",
   "firstAppearance": "s1",
   "summary": "First mention: “When, therefore, intelligence was received at the fort which covered the southern termination of the portage between the Hudson and the lakes, that Montcalm had been seen moving up the Champlain, with an army “numerou…”"
  },
  {
   "id": "mohican",
   "name": "Mohican",
   "role": "supporting",
   "firstAppearance": "s4",
   "summary": "First mention: “No, give me a Delaware or a Mohican for honesty; and when they will fight, which they won’t all do, having suffered their cunning enemies, the Maquas, to make them women—but when they will fight at all, look to a Dela…”"
  },
  {
   "id": "le-renard",
   "name": "Le Renard",
   "aliases": [
    "Renard"
   ],
   "role": "supporting",
   "firstAppearance": "s4",
   "summary": "First mention: “Whom call you Le Renard?””"
  },
  {
   "id": "tamenund",
   "name": "Tamenund",
   "role": "supporting",
   "firstAppearance": "s28",
   "summary": "First mention: “So soon as the first hum of emotion and pleasure, which the sudden appearance of this venerated individual created, had a little subsided, the name of “Tamenund” was whispered from mouth to mouth.”"
  },
  {
   "id": "le-subtil",
   "name": "Le Subtil",
   "aliases": [
    "Subtil"
   ],
   "role": "supporting",
   "firstAppearance": "s4",
   "summary": "First mention: ““Night is the same as day to Le Subtil, when Munro waits for him.””"
  },
  {
   "id": "david-gamut",
   "name": "David Gamut",
   "aliases": [
    "Gamut"
   ],
   "role": "supporting",
   "firstAppearance": "s6",
   "summary": "First mention: ““Gamut—David Gamut,” returned the singing master, preparing to wash down his sorrows in a powerful draught of the woodsman’s high-flavored and well-laced compound.”"
  },
  {
