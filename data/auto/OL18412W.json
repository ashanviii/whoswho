   "firstAppearance": "s1",
   "summary": "First mention: “A Faithful Record of Their Amazing Adventures in an Underground World; and How with the Aid of Their Friends Zeb Hugson, Eureka the Kitten, and Jim the Cab-Horse, They Finally Reached the Wonderful Land of Oz”"
  },
  {
   "id": "zeb",
   "name": "Zeb",
   "role": "major",
   "firstAppearance": "s1",
   "summary": "First mention: “\"My whole name is Zebediah; but folks just call me 'Zeb.”"
  },
  {
   "id": "eureka",
   "name": "Eureka",
   "role": "major",
   "firstAppearance": "s1",
   "summary": "First mention: “A Faithful Record of Their Amazing Adventures in an Underground World; and How with the Aid of Their Friends Zeb Hugson, Eureka the Kitten, and Jim the Cab-Horse, They Finally Reached the Wonderful Land of Oz”"
  },
  {
   "id": "princess",
   "name": "Princess",
   "role": "major",
   "firstAppearance": "s1",
   "summary": "First mention: “Dorothy Picks the Princess 6.”"
  },
  {
   "id": "ozma",
   "name": "Ozma",
   "role": "major",
   "firstAppearance": "s1",
   "summary": "First mention: “After the wonderful success of \"Ozma of Oz\" it is evident that Dorothy has become a firm fixture in these Oz stories.”"
  },
  {
   "id": "prince",
   "name": "Prince",
   "role": "supporting",
   "firstAppearance": "s2",
   "summary": "First mention: “\"No, my Prince.\"”"
  },
  {
   "id": "sawhorse",
   "name": "Sawhorse",
   "role": "supporting",
   "firstAppearance": "s10",
   "summary": "First mention: “\"We have never needed them before,\" answered Jellia; \"for the Sawhorse lives in a room of the palace, being much smaller and more natural in appearance than this great beast you have brought with you.\"”"
  },
  {
   "id": "mangaboos",
   "name": "Mangaboos",
   "role": "supporting",
   "firstAppearance": "s2",
   "summary": "First mention: “\"Why have you dared to intrude your unwelcome persons into the secluded Land of the Mangaboos?”"
  },
  {
   "id": "tin-woodman",
   "name": "Tin Woodman",
   "role": "supporting",
   "firstAppearance": "s6",
   "summary": "First mention: “\"But you must remember you had the Scarecrow and the Tin Woodman to help you conquer those enemies,\" suggested the Wizard.”"
  },
  {
   "id": "princess-ozma",
   "name": "Princess Ozma",
   "role": "minor",
   "firstAppearance": "s1",
   "summary": "First mention: “Princess Ozma, whom I love as much as my readers do, is again introduced in this story, and so are several of our old friends of Oz.”"
  },
  {
   "id": "ruler",
   "name": "Ruler",
   "role": "minor",
   "firstAppearance": "s3",
   "summary": "First mention: “\"She is the Ruler destined to be my successor, for she is a Royal Princess.”"
  },
  {
   "id": "uncle-henry",
   "name": "Uncle Henry",
   "role": "minor",
   "firstAppearance": "s1",
   "summary": "First mention: “\"Uncle Henry says 'Eureka' means 'I have found it.'\"”"
  },
  {
   "id": "champion",
   "name": "Champion",
   "role": "minor",
   "firstAppearance": "s6",
   "summary": "First mention: “Our greatest Champion, Overman-Anu, once climbed the spiral stairway and fought nine days with the Gargoyles before he could escape them and come back; but he could never be induced to describe the dreadful creatures,…”"
  },
  {
   "id": "billina",
   "name": "Billina",
   "role": "minor",
   "firstAppearance": "s9",
   "summary": "First mention: “\"Oh, he lives there too, with his friend the Hungry Tiger; and Billina is there, because she liked the place better than Kansas, and wouldn't go with me to Australia.\"”"
  },
  {
   "id": "gargoyle",
   "name": "Gargoyle",
   "role": "minor",
   "firstAppearance": "s7",
   "summary": "First mention: “Before this crowned Gargoyle had recovered himself Zeb had wound a strap several times around its body, confining its wings and arms so that it could not move.”"
  },
  {
   "id": "jellia",
   "name": "Jellia",
   "role": "minor",
   "firstAppearance": "s9",
   "summary": "First mention: “Wizard?\" asked Jellia, bowing low.”"
  },
  {
   "id": "tiger",
   "name": "Tiger",
   "role": "minor",
   "firstAppearance": "s11",
   "summary": "First mention: “The other was a great Tiger with purple stripes around his lithe body, powerful limbs, and eyes that showed through the half closed lids like coals of fire.”"
  },
  {
   "id": "gwig",
   "name": "Gwig",
   "role": "minor",
   "firstAppearance": "s2",
   "summary": "First mention: “\"Come to us, oh, Gwig!”"
  },
  {
   "id": "nome-king",
   "name": "Nome King",
   "role": "minor",
   "firstAppearance": "s6",
   "summary": "First mention: “They can't be worse than the Wicked Witch or the Nome King.\"”"
  },
  {
   "id": "nick-chopper",
   "name": "Nick Chopper",
   "role": "minor",
   "firstAppearance": "s10",
   "summary": "First mention: “But Ozma soon conquered her, with the help of Glinda the Good, and after that I went to live with Nick Chopper, the Tin Woodman.\"”"
  }
 ],
