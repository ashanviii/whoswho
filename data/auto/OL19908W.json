  {
   "id": "s1",
   "label": "Ch. 1",
   "title": "O ye who tread the Narrow Way"
  },
  {
   "id": "s2",
   "label": "Ch. 2"
  },
  {
   "id": "s3",
   "label": "Ch. 3",
   "title": "Yea, voice of every Soul that clung"
  },
  {
   "id": "s4",
   "label": "Ch. 4"
  },
  {
   "id": "s5",
   "label": "Ch. 5",
   "title": "Here come I to my own again"
  },
  {
   "id": "s6",
   "label": "Ch. 6",
   "title": "Now I remember comrades—"
  },
  {
   "id": "s7",
   "label": "Ch. 7",
   "title": "Unto whose use the pregnant suns are poised"
  },
  {
   "id": "s8",
   "label": "Ch. 8",
   "title": "Something I owe to the soil that grew—"
  },
  {
   "id": "s9",
   "label": "Ch. 9",
   "title": "S’ doaks was son of Yelth the wise—"
  },
  {
   "id": "s10",
   "label": "Ch. 10",
   "title": "Your tiercel’s too long at hack, Sire. He’s no eyass"
  },
  {
   "id": "s11",
   "label": "Ch. 11",
   "title": "Give the man who is not made"
  },
  {
   "id": "s12",
   "label": "Ch. 12"
  },
  {
   "id": "s13",
   "label": "Ch. 13"
  },
  {
   "id": "s14",
   "label": "Ch. 14",
   "title": "My brother kneels (so saith Kabir)"
  },
  {
   "id": "s15",
   "label": "Ch. 15",
   "title": "I’d not give room for an Emperor—"
  }
 ],
