 "characters": [
  {
   "id": "horne-fisher",
   "name": "Horne Fisher",
   "aliases": [
    "Fisher",
    "Mr. Horne Fisher"
   ],
   "role": "protagonist",
   "group": "g-fisher",
   "firstAppearance": "s1",
   "summary": "First mention: “Don't be surprised if I seem to be keeping it dark from some of our neighbors round here.\" Then, as if prompted to regularize his rather abrupt confidence, he said: \"I've come down to see my cousin at Torwood; my name…”"
  },
  {
   "id": "wilson",
   "name": "Wilson",
   "role": "supporting",
   "firstAppearance": "s2",
   "summary": "First mention: “\"Sit down, Wilson,\" he said.”"
  },
  {
   "id": "boyle",
   "name": "Boyle",
   "aliases": [
    "Captain Boyle"
   ],
   "role": "supporting",
   "firstAppearance": "s4",
   "summary": "First mention: “The first, who was a certain Captain Boyle, was of a bold and boyish type, dark, and with a sort of native heat in his face that did not belong to the atmosphere of the East, but rather to the ardors and ambitions of…”"
  },
  {
   "id": "verner",
   "name": "Verner",
   "aliases": [
    "Sir Francis Verner"
   ],
   "role": "supporting",
   "firstAppearance": "s7",
   "summary": "First mention: “And his face and phrases were on the front page of all the newspapers just then, because he was contesting the safe seat of Sir Francis Verner in the great by-election in the west.”"
  },
  {
   "id": "harold",
   "name": "Harold",
   "role": "supporting",
   "firstAppearance": "s1",
   "summary": "First mention: “Harold March, the rising reviewer and social critic, was walking vigorously across a great tableland of moors and commons, the horizon of which was fringed with the far-off woods of the famous estate of Torwood Park.”"
  },
  {
   "id": "sir-walter-carey",
   "name": "Sir Walter",
   "aliases": [
    "Sir Walter Carey"
   ],
   "role": "supporting",
   "firstAppearance": "s2",
   "summary": "First mention: “For this was Sir Walter Carey, an official of such eminence in Dublin Castle that nothing short of the case of Prince Michael would have brought him on such a journey in the middle of the night.”"
  },
  {
   "id": "prime-minister",
   "name": "Prime Minister",
   "aliases": [
    "Minister"
   ],
   "role": "supporting",
   "firstAppearance": "s2",
   "summary": "First mention: “And Sir Walter Carey is Prime Minister of this country, which he would probably never have been if the truth had been told of such a horrible scandal in his department.”"
  },
  {
   "id": "bulmer",
   "name": "Bulmer",
   "aliases": [
    "Lord Bulmer"
   ],
   "role": "supporting",
   "firstAppearance": "s6",
   "summary": "First mention: “Two men, the one an architect and the other an archaeologist, met on the steps of the great house at Prior's Park; and their host, Lord Bulmer, in his breezy way, thought it natural to introduce them.”"
  },
  {
   "id": "harker",
   "name": "Harker",
   "role": "minor",
   "firstAppearance": "s5",
   "summary": "First mention: “Didn't I hear that Harker was down here?\"”"
  },
  {
   "id": "grayne",
   "name": "Grayne",
   "role": "minor",
   "firstAppearance": "s4",
   "summary": "First mention: “\"Studying botany, or is it archaeology?\" inquired Grayne.”"
  },
  {
   "id": "brain",
   "name": "Brain",
   "aliases": [
    "Mr. Brain"
   ],
   "role": "minor",
   "firstAppearance": "s6",
   "summary": "First mention: “He was generally known with a severe simplicity as Mr.”"
  },
  {
   "id": "leonard-crane",
   "name": "Leonard Crane",
   "aliases": [
    "Crane"
   ],
   "role": "minor",
   "firstAppearance": "s6",
   "summary": "First mention: “The latter, whose name was Leonard Crane, came straight from a crude and almost cockney office of builders and house agents in the neighboring suburb, sunning itself at the end of a new row of jerry-built houses with…”"
  },
  {
   "id": "prince-michael",
   "name": "Prince Michael",
   "aliases": [
    "Michael"
   ],
   "role": "minor",
   "firstAppearance": "s2",
   "summary": "First mention: “The name is that of Michael O'Neill, popularly called Prince Michael, partly because he claimed descent from ancient Fenian princes, and partly because he was credited with a plan to make himself prince president of I…”"
  },
  {
   "id": "hook",
   "name": "Hook",
   "role": "minor",
   "firstAppearance": "s5",
   "summary": "First mention: “And here we have old Hook pretending to produce his own fish when he couldn't produce his own fish knives or fish forks to eat it with.”"
  },
  {
   "id": "burke",
   "name": "Burke",
   "role": "minor",
   "firstAppearance": "s1",
   "summary": "First mention: “\"That's John Burke, the traveler,\" he condescended to explain.”"
  },
  {
   "id": "morton",
   "name": "Morton",
   "role": "minor",
   "firstAppearance": "s2",
   "summary": "First mention: “His name was Morton, and he was a Liverpool man long pickled in the Irish quarrels, and doing his duty among them in a sour fashion not altogether unsympathetic.”"
  },
  {
   "id": "symon",
   "name": "Symon",
   "role": "minor",
   "firstAppearance": "s3",
   "summary": "First mention: “They descended a dark stone staircase, at the floor of which Symon pressed a button and a door opened on a dark room, or, rather, a room which had an instant before been dark.”"
  },
  {
   "id": "jenkins",
   "name": "Jenkins",
   "role": "minor",
   "firstAppearance": "s1",
   "summary": "First mention: “\"Now a new man's got it; a man from Montreal named Jenkins.”"
  },
  {
   "id": "travers",
   "name": "Travers",
   "role": "minor",
   "firstAppearance": "s4",
   "summary": "First mention: “\"And it was certainly jolly lucky that Travers turned up so well in the nick of time.”"
  },
  {
   "id": "mr-fisher",
   "name": "Mr. Fisher",
   "role": "minor",
   "group": "g-fisher",
   "firstAppearance": "s1",
   "summary": "First mention: “Are you an admirer of your great kinsman, Mr.”"
  },
  {
   "id": "nolan",
   "name": "Nolan",
   "role": "minor",
   "firstAppearance": "s2",
   "summary": "First mention: “He had spoken a few sentences to his companion, Nolan, a tall, dark man with a cadaverous equine Irish face, when he seemed to remember something and touched a bell which rang in another room.”"
  },
  {
   "id": "sir-isaac",
   "name": "Sir Isaac",
   "role": "minor",
   "firstAppearance": "s5",
   "summary": "First mention: “He was the nephew of Sir Isaac; but, what was much more important at the moment, he was also the private secretary of the Prime Minister.”"
  },
  {
   "id": "harry-fisher",
   "name": "Harry Fisher",
   "aliases": [
    "Harry"
   ],
   "role": "minor",
   "group": "g-fisher",
   "firstAppearance": "s7",
   "summary": "First mention: “Nobody privileged of late years to meet Sir Henry Harland Fisher would believe that he had ever been called Harry.”"
  },
  {
   "id": "mr-prior",
   "name": "Mr. Prior",
   "role": "minor",
   "firstAppearance": "s6",
   "summary": "First mention: “It was the house of a Mr.”"
  },
  {
   "id": "herries",
   "name": "Herries",
   "role": "minor",
   "firstAppearance": "s8",
   "summary": "First mention: “It drives me mad when Herries will wear his hat a little crooked--habit of looking like a gay dog.”"
  },
  {
   "id": "jink",
   "name": "Jink",
   "role": "minor",
   "firstAppearance": "s1",
   "summary": "First mention: “\"So you're stopping at Jink's, too,\" said Fisher.”"
  },
  {
   "id": "gryce",
   "name": "Gryce",
   "role": "minor",
   "firstAppearance": "s7",
   "summary": "First mention: “Eric Hughes, with his blown blond hair and eager undergraduate face, was just getting into his motor car and saying a few final words to his agent, a sturdy, grizzled man named Gryce.”"
  },
  {
   "id": "exchequer",
   "name": "Exchequer",
   "role": "minor",
   "firstAppearance": "s1",
   "summary": "First mention: “For his errand at Torwood Park was a political one; it was the place of appointment named by no less a person than the Chancellor of the Exchequer, Sir Howard Horne, then introducing his so-called Socialist budget, an…”"
  },
  {
   "id": "twyford",
   "name": "Twyford",
   "role": "minor",
   "firstAppearance": "s3",
   "summary": "First mention: “Twyford started for a second, and then said, sharply:”"
  },
  {
   "id": "hugo",
   "name": "Hugo",
   "role": "minor",
   "firstAppearance": "s5",
   "summary": "First mention: “\"On the very top of Sir Isaac's papers,\" explained Harker, \"there was a threatening letter from a man named Hugo.”"
  },
  {
   "id": "hoggs",
   "name": "Hoggs",
   "role": "minor",
   "firstAppearance": "s1",
   "summary": "First mention: “I believe Hoggs--I mean my cousin Howard--was coming down specially to meet him.\"”"
  },
  {
   "id": "sir-howard",
   "name": "Sir Howard",
   "role": "minor",
   "firstAppearance": "s1",
   "summary": "First mention: “But he was himself too early for his appointment with Sir Howard, and was not disinclined to see the end of his new friend's experiment, whatever it might be.”"
  }
 ],
