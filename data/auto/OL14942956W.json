   "name": "Judge Miller",
   "aliases": [
    "Judge"
   ],
   "role": "minor",
   "firstAppearance": "s1",
   "summary": "First mention: “Judge Miller’s place, it was called.”"
  },
  {
   "id": "charles",
   "name": "Charles",
   "role": "minor",
   "firstAppearance": "s5",
   "summary": "First mention: “The men addressed each other as “Hal” and “Charles.”"
  },
  {
