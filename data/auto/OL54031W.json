  {
   "id": "dowley",
   "name": "Dowley",
   "role": "major",
   "firstAppearance": "s31",
   "summary": "First mention: “I got to know several master mechanics, but about the most interesting fellow among them was the blacksmith, Dowley.”"
  },
  {
