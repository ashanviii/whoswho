 "characters": [
  {
   "id": "candide",
   "name": "Candide",
   "role": "protagonist",
   "firstAppearance": "s1",
   "summary": "First mention: “He combined a true judgment with simplicity of spirit, which was the reason, I apprehend, of his being called Candide.”"
  },
  {
   "id": "martin",
   "name": "Martin",
   "role": "major",
   "firstAppearance": "s20",
   "summary": "First mention: “The old philosopher, whose name was Martin, embarked then with Candide for Bordeaux.”"
  },
  {
   "id": "cunegonde",
   "name": "Cunegonde",
   "role": "major",
   "firstAppearance": "s1",
   "summary": "First mention: “Her daughter Cunegonde was seventeen years of age, fresh-coloured, comely, plump, and desirable.”"
  },
  {
   "id": "pangloss",
   "name": "Pangloss",
   "aliases": [
    "Master Pangloss"
   ],
   "role": "major",
   "firstAppearance": "s1",
   "summary": "First mention: “The Preceptor Pangloss[1] was the oracle of the family, and little Candide heard his lessons with all the good faith of his age and character.”"
  },
  {
   "id": "cacambo",
   "name": "Cacambo",
   "role": "major",
   "firstAppearance": "s14",
   "summary": "First mention: “His name was Cacambo, and he loved his master, because his master was a very good man.”"
  },
  {
   "id": "miss-cunegonde",
   "name": "Miss Cunegonde",
   "role": "supporting",
   "firstAppearance": "s1",
   "summary": "First mention: “Candide listened attentively and believed innocently; for he thought Miss Cunegonde extremely beautiful, though he never had the courage to tell her so.”"
  },
  {
   "id": "baron",
   "name": "Baron",
   "role": "supporting",
   "firstAppearance": "s1",
   "summary": "First mention: “In a castle of Westphalia, belonging to the Baron of Thunder-ten-Tronckh, lived a youth, whom nature had endowed with the most gentle manners.”"
  },
  {
   "id": "king",
   "name": "King",
   "role": "minor",
   "firstAppearance": "s2",
   "summary": "First mention: “\"No,\" said one of the gentlemen, \"we ask you if you do not deeply love the King of the Bulgarians?\"”"
  },
  {
   "id": "paquette",
   "name": "Paquette",
   "role": "minor",
   "firstAppearance": "s4",
   "summary": "First mention: “Pangloss made answer in these terms: \"Oh, my dear Candide, you remember Paquette, that pretty wench who waited on our noble Baroness; in her arms I tasted the delights of paradise, which produced in me those hell torm…”"
  },
  {
   "id": "inquisitor",
   "name": "Inquisitor",
   "role": "minor",
   "firstAppearance": "s8",
   "summary": "First mention: “\"The Grand Inquisitor, seeing me one day at Mass, stared long at me, and sent to tell me that he wished to speak on private matters.”"
  },
  {
   "id": "voltaire",
   "name": "Voltaire",
   "role": "minor",
   "firstAppearance": "s30",
   "summary": "First mention: “I drove three great nails through her behind; it is then she would have wept if she had been able.'\"--Voltaire, _Mélanges_.”"
  },
