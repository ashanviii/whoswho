  },
  {
   "id": "toto",
   "name": "Toto",
   "role": "major",
   "firstAppearance": "s1",
   "summary": "First mention: “Toto is in this story, because you wanted him to be there, and many other characters which you will recognize are in the story, too.”"
  },
  {
   "id": "ozma",
   "name": "Ozma",
   "role": "major",
   "firstAppearance": "s3",
   "summary": "First mention: “\"Do you know Ozma?”"
  },
  {
   "id": "polly",
   "name": "Polly",
   "role": "supporting",
   "firstAppearance": "s4",
   "summary": "First mention: “\"Polly whom?\"”"
  },
  {
   "id": "polychrome",
   "name": "Polychrome",
   "role": "supporting",
   "firstAppearance": "s1",
   "summary": "First mention: “In which is related how Dorothy Gale of Kansas, The Shaggy Man, Button Bright, and Polychrome the Rainbow's Daughter met on an Enchanted Road and followed it all the way to the Marvelous Land of Oz.”"
  },
  {
   "id": "billina",
   "name": "Billina",
   "role": "supporting",
   "firstAppearance": "s1",
   "summary": "First mention: “Tik-Tok and Billina 15.”"
  },
  {
   "id": "king",
   "name": "King",
   "role": "supporting",
   "firstAppearance": "s3",
   "summary": "First mention: “Dorothy knew the King at once, because she had seen his head carved on the arch and over the doorway of the palace.”"
  },
  {
   "id": "emerald",
   "name": "Emerald",
   "role": "supporting",
   "firstAppearance": "s3",
   "summary": "First mention: “\"I'm sure Ozma would invite you if I asked her,\" she said; \"but how could you get to the Land of Oz and the Emerald City?”"
  },
  {
   "id": "princess-ozma",
   "name": "Princess Ozma",
   "role": "supporting",
   "firstAppearance": "s1",
   "summary": "First mention: “Princess Ozma of Oz 21.”"
  },
  {
   "id": "scarecrow",
   "name": "Scarecrow",
   "role": "supporting",
   "firstAppearance": "s4",
   "summary": "First mention: “\"Will the Scarecrow scare me?”"
  },
  {
   "id": "scoodlers",
   "name": "Scoodlers",
