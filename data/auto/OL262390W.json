   "firstAppearance": "s1",
   "summary": "First mention: “Facing the Scoodlers 10.”"
  },
  {
   "id": "wizard",
   "name": "Wizard",
   "role": "supporting",
   "firstAppearance": "s1",
   "summary": "First mention: “In the preface to \"Dorothy and the Wizard of Oz\" I said I would like to write some stories that were not \"Oz\" stories, because I thought I had written about Oz long enough; but since that volume was published I have b…”"
  },
  {
   "id": "princess",
   "name": "Princess",
   "role": "minor",
   "firstAppearance": "s3",
   "summary": "First mention: “\"If we can manage to get to Ozma,\" she said, \"the Princess will change you back to yourself in half a second; so you just wear that fox head as comf't'bly as you can, dear, and don't worry about it at all.”"
  },
  {
   "id": "tik",
   "name": "Tik",
   "role": "minor",
   "firstAppearance": "s8",
   "summary": "First mention: “\"Oh, Tik-tok!”"
  },
  {
   "id": "queen",
   "name": "Queen",
   "role": "minor",
   "firstAppearance": "s7",
   "summary": "First mention: “For the Queen of the Scoodlers proved to be much more dreadful in appearance than any of her people.”"
  },
