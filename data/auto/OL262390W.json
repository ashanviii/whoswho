   "firstAppearance": "s1",
   "summary": "First mention: “Well, my dears, here is what you have asked for: another \"Oz Book\" about Dorothy's strange adventures.”"
  },
  {
   "id": "button-bright",
   "name": "Button-Bright",
   "role": "major",
   "firstAppearance": "s1",
