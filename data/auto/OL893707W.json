   "name": "Rouault",
   "aliases": [
    "Monsieur Rouault"
   ],
   "role": "minor",
   "firstAppearance": "s2",
   "summary": "First mention: “The general practitioner, riding along, gathered from his guide’s talk that Monsieur Rouault must be one of the well-to-do farmers.”"
  },
  {
   "id": "madame-lefrancois",
   "name": "Madame Lefrancois",
   "role": "minor",
   "firstAppearance": "s10",
   "summary": "First mention: ““Since that one is coming to pieces, Madame Lefrancois.”"
