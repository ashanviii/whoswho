 "characters": [
  {
   "id": "venters",
   "name": "Venters",
   "role": "protagonist",
   "firstAppearance": "s1",
   "summary": "First mention: “Venters and Bess finished their simple meal—then faced the open terrace, to watch and await the approaching storm.”"
  },
  {
   "id": "lassiter",
   "name": "Lassiter",
   "role": "protagonist",
   "firstAppearance": "s2",
   "summary": "First mention: “You’ll make me another Lassiter!””"
  },
  {
   "id": "jane",
   "name": "Jane",
   "role": "protagonist",
   "firstAppearance": "s1",
   "summary": "First mention: “Can he be Oldring’s Masked Rider?” “What on earth is that?” He did not pause until he gained the narrow divide “Bess, I’ll not go again” It was Jane’s gaze riveted upon the rider that made Bishop Dyer turn.”"
  },
  {
   "id": "bess",
   "name": "Bess",
   "role": "major",
   "firstAppearance": "s1",
   "summary": "First mention: “Can he be Oldring’s Masked Rider?” “What on earth is that?” He did not pause until he gained the narrow divide “Bess, I’ll not go again” It was Jane’s gaze riveted upon the rider that made Bishop Dyer turn.”"
  },
  {
   "id": "elder-tull",
   "name": "Elder Tull",
   "aliases": [
    "Tull",
    "Elder"
   ],
   "role": "major",
   "firstAppearance": "s2",
   "summary": "First mention: “They were seven in number, and Tull, the leader, a tall, dark man, was an elder of Jane’s church.”"
  },
  {
   "id": "jane-withersteen",
   "name": "Jane Withersteen",
   "aliases": [
    "Miss Withersteen"
   ],
   "role": "major",
   "firstAppearance": "s2",
   "summary": "First mention: “Jane Withersteen gazed down the wide purple slope with dreamy and troubled eyes.”"
  },
  {
   "id": "wrangle",
   "name": "Wrangle",
   "role": "supporting",
   "firstAppearance": "s1",
   "summary": "First mention: “just as Wrangle plunged again he caught the whizz of a leaden missile and Venters shot him through the heart “Don’t—look—back!”"
  },
  {
   "id": "fay",
   "name": "Fay",
   "role": "supporting",
   "firstAppearance": "s2",
   "summary": "First mention: “Besides I owe him eternal gratitude for saving the life of little Fay.””"
  },
  {
   "id": "oldring",
   "name": "Oldring",
   "role": "supporting",
   "firstAppearance": "s3",
   "summary": "First mention: “Oldring and his rustlers live somewhere down there.””"
  },
  {
   "id": "milly-erne",
   "name": "Milly Erne",
   "aliases": [
    "Milly"
   ],
   "role": "supporting",
   "group": "g-erne",
   "firstAppearance": "s3",
   "summary": "First mention: ““Milly Erne’s grave,” he answered low, and the words came with a wrench.”"
  },
  {
   "id": "bishop-dyer",
   "name": "Bishop Dyer",
   "aliases": [
    "Dyer",
    "Bishop"
   ],
   "role": "supporting",
   "firstAppearance": "s1",
   "summary": "First mention: “Can he be Oldring’s Masked Rider?” “What on earth is that?” He did not pause until he gained the narrow divide “Bess, I’ll not go again” It was Jane’s gaze riveted upon the rider that made Bishop Dyer turn.”"
  },
  {
   "id": "judkins",
   "name": "Judkins",
   "role": "supporting",
   "firstAppearance": "s4",
   "summary": "First mention: ““Jane, when Judkins rides like that it means hell!””"
  },
  {
