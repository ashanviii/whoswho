  },
  {
   "id": "ring",
   "name": "Ring",
   "role": "minor",
   "firstAppearance": "s4",
   "summary": "First mention: “He called them Ring and Whitie; they were sheep-dogs, half collie, half deerhound, superb in build, perfectly trained.”"
  },
  {
   "id": "whitie",
   "name": "Whitie",
   "role": "minor",
   "firstAppearance": "s4",
   "summary": "First mention: “He called them Ring and Whitie; they were sheep-dogs, half collie, half deerhound, superb in build, perfectly trained.”"
  },
  {
   "id": "bells",
   "name": "Bells",
   "role": "minor",
   "firstAppearance": "s4",
   "summary": "First mention: ““Why, Bells—Wrangle, where are your manners?”"
  },
  {
   "id": "blake",
   "name": "Blake",
   "role": "minor",
   "firstAppearance": "s7",
   "summary": "First mention: “Well, I met Blake en’ Dorn, both good friends of mine, usually, as far as their Mormon lights will let ’em go.”"
  },
  {
   "id": "gentile",
   "name": "Gentile",
   "role": "minor",
   "firstAppearance": "s2",
   "summary": "First mention: “A rider had just left her and it was his message that held her thoughtful and almost sad, awaiting the churchmen who were coming to resent and attack her right to befriend a Gentile.”"
  },
  {
   "id": "frank-erne",
   "name": "Frank Erne",
   "aliases": [
    "Frank"
   ],
   "role": "minor",
   "group": "g-erne",
   "firstAppearance": "s20",
   "summary": "First mention: “Milly had always been strong on religion, an’ when she met Frank Erne she went in heart an’ soul for the salvation of souls.”"
  },
  {
   "id": "jerry",
   "name": "Jerry",
   "role": "minor",
   "firstAppearance": "s2",
   "summary": "First mention: ““Here, Jerry,” called Tull, turning to his men, “take the gang and fetch Venters out here if you have to rope him.””"
  },
  {
   "id": "oldrin",
   "name": "Oldrin",
   "role": "minor",
   "firstAppearance": "s4",
   "summary": "First mention: “Oldrin’s got a high hand here, I reckon.”"
  },
