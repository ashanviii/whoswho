    {
      "id": "romeo",
      "name": "Romeo",
      "role": "protagonist",
      "group": "montague",
      "firstAppearance": "1.1",
      "summary": "Only son of Montague, moping over an unrequited love.",
      "notes": [
        {
          "at": "1.5",
          "text": "Falls in love with Juliet at the Capulet feast."
        },
        {
          "at": "2.6",
          "text": "Secretly marries Juliet."
        },
        {
          "at": "3.1",
          "text": "Kills Tybalt and is banished from Verona."
        },
        {
          "at": "5.3",
          "text": "Believing Juliet dead, poisons himself in the Capulet tomb."
        }
      ]
    },
