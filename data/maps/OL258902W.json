  "characters": [
    {
      "id": "macbeth",
      "name": "Macbeth",
      "role": "protagonist",
      "group": "macbeth",
      "firstAppearance": "1.1",
      "summary": "Thane of Glamis, a brave general in King Duncan’s army.",
      "notes": [
        {
          "at": "1.3",
          "text": "The witches hail him as Thane of Cawdor and king hereafter."
        },
        {
          "at": "2.2",
          "text": "Murders King Duncan in his sleep."
        },
        {
          "at": "3.1",
          "text": "Hires murderers to kill Banquo and his son."
        },
        {
          "at": "4.1",
          "text": "Orders the slaughter of Macduff’s family."
        },
        {
          "at": "5.8",
          "text": "Is killed by Macduff."
        }
      ]
    },
    {
      "id": "lady",
      "name": "Lady Macbeth",
      "role": "protagonist",
      "group": "macbeth",
      "firstAppearance": "1.5",
      "summary": "Macbeth’s wife, ambitious and iron-willed.",
      "notes": [
        {
          "at": "1.7",
          "text": "Taunts her wavering husband into going through with the murder."
        },
        {
          "at": "5.1",
          "text": "Walks in her sleep, trying to wash away imagined blood."
        },
        {
          "at": "5.5",
          "text": "Her death is reported to Macbeth."
        }
      ]
    },
    {
      "id": "witches",
      "name": "The Weird Sisters",
      "role": "major",
      "group": "weird",
      "firstAppearance": "1.1",
      "summary": "Three witches who meet upon the heath amid thunder and lightning."
    },
    {
      "id": "hecate",
      "name": "Hecate",
      "role": "minor",
      "group": "weird",
      "firstAppearance": "3.5",
      "summary": "Queen of the witches."
    },
    {
      "id": "duncan",
      "name": "King Duncan",
      "role": "major",
      "group": "royal",
      "firstAppearance": "1.2",
      "summary": "The gracious, trusting King of Scotland.",
      "notes": [
        {
          "at": "2.3",
          "text": "Is found murdered in his bed at Macbeth’s castle."
        }
      ]
    },
    {
      "id": "malcolm",
      "name": "Malcolm",
      "role": "major",
      "group": "royal",
      "firstAppearance": "1.2",
      "summary": "Duncan’s elder son.",
      "notes": [
        {
          "at": "1.4",
          "text": "Is named Prince of Cumberland, heir to the throne."
        },
        {
          "at": "2.3",
          "text": "Flees to England after his father’s murder."
        },
        {
          "at": "5.8",
          "text": "Is hailed King of Scotland."
        }
      ]
    },
    {
      "id": "donalbain",
      "name": "Donalbain",
      "role": "minor",
      "group": "royal",
      "firstAppearance": "2.3",
      "summary": "Duncan’s younger son, who flees to Ireland."
    },
    {
      "id": "banquo",
      "name": "Banquo",
      "role": "major",
      "group": "banquo",
      "firstAppearance": "1.2",
      "summary": "A general and Macbeth’s comrade-in-arms.",
      "notes": [
        {
          "at": "3.3",
          "text": "Is murdered on the road; his son escapes."
        },
        {
          "at": "3.4",
          "text": "His ghost appears at Macbeth’s banquet."
        }
      ]
    },
    {
      "id": "fleance",
      "name": "Fleance",
      "role": "minor",
      "group": "banquo",
      "firstAppearance": "2.1",
      "summary": "Banquo’s young son.",
      "notes": [
        {
          "at": "3.3",
          "text": "Escapes the murderers."
        }
      ]
    },
    {
      "id": "macduff",
      "name": "Macduff",
      "role": "major",
      "group": "macduff",
      "firstAppearance": "2.3",
      "summary": "Thane of Fife, a loyal and plain-spoken nobleman.",
      "notes": [
        {
          "at": "2.3",
          "text": "Discovers Duncan’s body."
        },
        {
          "at": "4.3",
          "text": "Learns in England that his wife and children have been slaughtered."
        }
      ]
    },
