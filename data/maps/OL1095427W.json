  "characters": [
    {
      "id": "jane",
      "name": "Jane Eyre",
      "role": "protagonist",
      "firstAppearance": "c1",
      "summary": "The narrator: an orphaned ten-year-old living unwanted with her aunt’s family at Gateshead Hall.",
      "notes": [
        {
          "at": "c10",
          "text": "After eight years at Lowood, advertises for and takes a post as governess."
        },
        {
          "at": "c26",
          "text": "Her wedding is halted at the altar."
        },
        {
          "at": "c27",
          "text": "Leaves Thornfield secretly, with almost nothing."
        },
        {
          "at": "c33",
          "text": "Learns she has inherited £20,000 from her uncle, and divides it with her newly found cousins."
        },
        {
          "at": "c38",
          "text": "Marries Rochester."
        }
      ]
    },
    {
      "id": "mrsReed",
      "name": "Mrs. Reed",
      "aliases": [
        "Sarah Reed"
      ],
      "role": "supporting",
      "group": "reed",
      "firstAppearance": "c1",
      "summary": "Jane’s cold aunt by marriage, mistress of Gateshead Hall.",
      "notes": [
        {
          "at": "c21",
          "text": "On her deathbed confesses she hid a letter from Jane’s uncle, and dies unreconciled."
        }
      ]
    },
    {
      "id": "johnReed",
      "name": "John Reed",
      "role": "minor",
      "group": "reed",
      "firstAppearance": "c1",
      "summary": "Jane’s bullying fourteen-year-old cousin.",
      "notes": [
        {
          "at": "c21",
          "text": "Has died — reportedly by his own hand — after ruining himself and his mother."
        }
      ]
    },
    {
      "id": "eliza",
      "name": "Eliza Reed",
      "role": "minor",
      "group": "reed",
      "firstAppearance": "c1",
      "summary": "Jane’s elder cousin, cold and self-contained."
    },
    {
      "id": "georgianaReed",
      "name": "Georgiana Reed",
      "role": "minor",
      "group": "reed",
      "firstAppearance": "c1",
      "summary": "Jane’s pretty, spoiled cousin."
    },
    {
      "id": "bessie",
      "name": "Bessie Lee",
      "role": "supporting",
      "group": "reed",
      "firstAppearance": "c1",
      "summary": "Gateshead nursemaid, quick-tempered but the one person there who is kind to Jane.",
      "notes": [
        {
          "at": "c10",
          "text": "Visits Jane before she leaves Lowood, now married to the coachman Robert Leaven."
        }
      ]
    },
    {
      "id": "mrLloyd",
      "name": "Mr. Lloyd",
      "role": "minor",
      "firstAppearance": "c3",
      "summary": "Apothecary called to Jane after the red-room; he suggests she be sent to school."
    },
    {
      "id": "brocklehurst",
      "name": "Mr. Brocklehurst",
      "role": "supporting",
      "group": "lowood",
      "firstAppearance": "c4",
      "summary": "Harsh, hypocritical clergyman who runs Lowood School.",
      "notes": [
        {
          "at": "c7",
          "text": "Stands Jane on a stool and denounces her to the whole school as a liar."
        }
      ]
    },
    {
      "id": "helen",
      "name": "Helen Burns",
      "role": "major",
      "group": "lowood",
      "firstAppearance": "c5",
      "summary": "Patient, deeply religious older pupil at Lowood.",
      "notes": [
        {
          "at": "c9",
          "text": "Dies of consumption with Jane in her arms."
        }
      ]
    },
    {
      "id": "missTemple",
      "name": "Miss Temple",
      "aliases": [
        "Maria Temple"
      ],
      "role": "supporting",
      "group": "lowood",
      "firstAppearance": "c5",
      "summary": "Kind, dignified superintendent of Lowood.",
      "notes": [
        {
          "at": "c10",
          "text": "Marries and leaves Lowood."
        }
      ]
    },
    {
      "id": "rochester",
      "name": "Edward Rochester",
      "aliases": [
        "Mr. Rochester",
        "Edward Fairfax Rochester"
      ],
      "role": "protagonist",
      "group": "thornfield",
      "firstAppearance": "c11",
      "summary": "Brooding, sardonic master of Thornfield Hall, usually away.",
      "notes": [
        {
          "at": "c12",
          "text": "Meets Jane in the lane when his horse slips on the ice."
        },
        {
          "at": "c15",
          "text": "Jane saves him from a fire set in his bedroom."
        },
        {
          "at": "c23",
          "text": "Proposes to Jane."
        },
        {
          "at": "c26",
          "text": "Is revealed to have a living wife."
        },
        {
          "at": "c36",
          "text": "Was blinded and lost a hand trying to save Bertha when Thornfield burned."
        },
        {
          "at": "c38",
          "text": "Marries Jane and regains some sight in one eye."
        }
      ]
    },
    {
      "id": "fairfax",
      "name": "Mrs. Fairfax",
      "role": "supporting",
      "group": "thornfield",
      "firstAppearance": "c11",
      "summary": "Kindly, elderly housekeeper of Thornfield."
    },
    {
      "id": "adele",
      "name": "Adèle Varens",
      "role": "supporting",
      "group": "thornfield",
      "firstAppearance": "c11",
      "summary": "Rochester’s lively young French ward and Jane’s pupil."
    },
    {
      "id": "grace",
      "name": "Grace Poole",
      "role": "supporting",
      "group": "thornfield",
      "firstAppearance": "c11",
      "summary": "Stolid servant who sews on the third storey and is blamed for strange laughter there.",
      "notes": [
        {
          "at": "c26",
          "text": "Is revealed to be Bertha Mason’s paid keeper."
        }
      ]
    },
    {
      "id": "celine",
      "name": "Céline Varens",
      "role": "minor",
      "firstAppearance": "c15",
      "summary": "French opera dancer, Rochester’s former mistress."
    },
    {
      "id": "blanche",
      "name": "Blanche Ingram",
      "role": "supporting",
      "firstAppearance": "c16",
      "summary": "Beautiful, haughty society belle widely expected to marry Rochester."
    },
    {
      "id": "mason",
      "name": "Richard Mason",
      "role": "supporting",
      "group": "mason",
      "firstAppearance": "c18",
      "summary": "A visitor from the West Indies, an old acquaintance of Rochester.",
      "notes": [
        {
          "at": "c20",
          "text": "Is stabbed and bitten in the night on the third storey."
        },
        {
          "at": "c26",
          "text": "Interrupts the wedding with a lawyer."
        }
      ]
    },
    {
      "id": "bertha",
      "name": "Bertha Mason",
      "aliases": [
        "Bertha Antoinetta Mason",
        "Mrs. Rochester"
      ],
      "role": "major",
      "group": "mason",
      "firstAppearance": "c26",
      "summary": "Rochester’s wife, confined for years in the third-storey rooms at Thornfield; the source of the laughter and the night attacks.",
      "notes": [
        {
          "at": "c36",
          "text": "Set fire to Thornfield and died leaping from the roof."
        }
      ]
    },
    {
      "id": "stJohn",
      "name": "St. John Rivers",
      "role": "major",
      "group": "rivers",
      "firstAppearance": "c28",
      "summary": "Handsome, ambitious and austere clergyman of Morton.",
      "notes": [
        {
          "at": "c34",
          "text": "Asks Jane to marry him and go with him to India as a missionary."
        },
        {
          "at": "c38",
          "text": "Labours as a missionary in India, expecting his death."
        }
      ]
    },
    {
      "id": "diana",
      "name": "Diana Rivers",
      "role": "supporting",
      "group": "rivers",
      "firstAppearance": "c28",
      "summary": "St. John’s warm, spirited sister, a governess."
    },
    {
      "id": "maryRivers",
      "name": "Mary Rivers",
      "role": "supporting",
      "group": "rivers",
      "firstAppearance": "c28",
      "summary": "St. John’s gentle sister, also a governess."
    },
    {
      "id": "hannah",
      "name": "Hannah",
      "role": "minor",
      "group": "rivers",
      "firstAppearance": "c28",
      "summary": "The Riverses’ wary, devoted old servant."
    },
    {
      "id": "rosamond",
      "name": "Rosamond Oliver",
      "role": "supporting",
      "firstAppearance": "c31",
      "summary": "Beautiful, good-natured heiress who funds the Morton school."
    },
    {
      "id": "johnEyre",
      "name": "John Eyre",
      "role": "minor",
      "firstAppearance": "c10",
      "summary": "Jane’s paternal uncle, a merchant in Madeira.",
      "notes": [
        {
          "at": "c21",
          "text": "Wrote three years ago wishing to adopt Jane; Mrs. Reed told him she had died."
        },
        {
          "at": "c33",
          "text": "Has died, leaving Jane his fortune."
        }
      ]
    }
  ],
