  "characters": [
    {
      "id": "hamlet",
      "name": "Prince Hamlet",
      "aliases": [
        "Hamlet"
      ],
      "role": "protagonist",
      "group": "royal",
      "firstAppearance": "1.1",
      "summary": "Prince of Denmark, a student at Wittenberg, in deep mourning for his father.",
      "notes": [
        {
          "at": "1.5",
          "text": "Learns from the Ghost that his father was murdered, and swears revenge."
        },
        {
          "at": "3.2",
          "text": "Uses a play to confirm Claudius’s guilt."
        },
        {
          "at": "3.4",
          "text": "Kills Polonius, hidden behind the arras."
        },
        {
          "at": "4.6",
          "text": "Escapes the voyage to England by way of a pirate ship."
        },
        {
          "at": "5.2",
          "text": "Kills Claudius and dies of Laertes’s poisoned blade."
        }
      ]
    },
    {
      "id": "ghost",
      "name": "The Ghost",
      "aliases": [
        "King Hamlet"
      ],
      "role": "major",
      "group": "royal",
      "firstAppearance": "1.1",
      "summary": "An apparition in the armour of the late King Hamlet, seen on the battlements of Elsinore.",
      "notes": [
        {
          "at": "1.5",
          "text": "Tells Hamlet he was poisoned in his sleep by his brother."
        }
      ]
    },
    {
      "id": "claudius",
      "name": "King Claudius",
      "aliases": [
        "Claudius"
      ],
      "role": "major",
      "group": "royal",
      "firstAppearance": "1.2",
      "summary": "The new King of Denmark, brother of the late king.",
      "notes": [
        {
          "at": "3.3",
          "text": "Alone at prayer, confesses that he murdered his brother."
        },
        {
          "at": "4.7",
          "text": "Plots with Laertes to kill Hamlet in a rigged fencing match."
        },
        {
          "at": "5.2",
          "text": "Is killed by Hamlet."
        }
      ]
    },
    {
      "id": "gertrude",
      "name": "Queen Gertrude",
      "aliases": [
        "Gertrude"
      ],
      "role": "major",
      "group": "royal",
      "firstAppearance": "1.2",
      "summary": "Queen of Denmark, Hamlet’s mother, who has hastily married Claudius.",
      "notes": [
        {
          "at": "5.2",
          "text": "Drinks the poisoned cup meant for Hamlet and dies."
        }
      ]
    },
    {
      "id": "polonius",
      "name": "Polonius",
      "role": "major",
      "group": "polonius",
      "firstAppearance": "1.2",
      "summary": "Lord Chamberlain and Claudius’s long-winded chief counsellor.",
      "notes": [
        {
          "at": "3.4",
          "text": "Is stabbed through the arras by Hamlet while spying."
        }
      ]
    },
    {
      "id": "laertes",
      "name": "Laertes",
      "role": "major",
      "group": "polonius",
      "firstAppearance": "1.2",
      "summary": "Polonius’s son, eager to return to France.",
      "notes": [
        {
          "at": "4.5",
          "text": "Storms back from France at the head of a mob, demanding vengeance for his father."
        },
        {
          "at": "5.2",
          "text": "Wounds Hamlet with a poisoned blade, is killed by it himself, and exposes the King."
        }
      ]
    },
    {
      "id": "ophelia",
      "name": "Ophelia",
      "role": "major",
      "group": "polonius",
      "firstAppearance": "1.3",
      "summary": "Polonius’s daughter, courted by Hamlet.",
      "notes": [
        {
          "at": "4.5",
          "text": "Is driven mad by grief for her father."
        },
        {
          "at": "4.7",
          "text": "Drowns, Gertrude reports, while hanging flowers on a willow."
        }
      ]
    },
