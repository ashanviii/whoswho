ters":[{"id":"tom-loker","name":"Tom Loker","aliases":["Tom","Uncle Tom","Loker"],"role":"protagonist","firstAppearance":"s1","summary":"First mention: ““Why, the fact is, Haley, Tom is an uncommon fellow; he is certainly worth that sum anywhere,—steady, honest, capable, manages my whole farm like a clock.””"},{"id":"st-clare","name":"St. Clare","role":"major","firstAppearance":"s14","summary":"First mention: “Among the passengers on the boat was a young gentleman of fortune and family, resident in New Orleans, who bore the name of St.”"},{"id":"miss-ophelia","name":"Miss Ophelia","aliases":["Ophelia"],"role":"major","firstAppearance":"s15","summary":"First mention: “And now, while the distant domes and spires of New Orleans rise to our view, there is yet time for an introduction to Miss Ophelia.”"},{"id":"eva","name":"Eva","role":"major","firstAppearance":"s14","summary":"First mention: “Clare,” said the little one, “though papa and everybody else call me Eva.”"},{"id":"mas-r-haley","name":"Mas’r Haley","aliases":["Haley","Mr. Haley"],"role":"major","firstAppearance":"s1","summary":"First mention: ““Why, the fact is, Haley, Tom is an uncommon fellow; he is certainly worth that sum anywhere,—steady, honest, capable, manages my whole farm like a clock.””"},{"id":"misse-cassy","name":"Misse Cassy","aliases":["Cassy"],"role":"major","firstAppearance":"s33","summary":"First mention: “Cassy”"},{"id":"eliza","name":"Eliza","role":"supporting","firstAppearance":"s1","summary":"First mention: ““Well, Eliza?”"},{"id":"aunt-chloe","name":"Aunt Chloe","aliases":["Chloe"],"role":"supporting","firstAppearance":"s4","summary":"First mention: “Here, also, in summer, various brilliant annuals, such as marigolds, petunias, four-o’clocks, found an indulgent corner in which to unfold their splendors, and were the delight and pride of Aunt Chloe’s heart.”"},{"id":"marie","name":"Marie","role":"supporting","firstAppearance":"s15","summary":"First mention: “Marie never had possessed much capability of affection, or much sensibility, and the little that she had, had been merged into a most intense and unconscious selfishness; a selfishness the more hopeless, from its quie…”"},{"id":"topsy","name":"Topsy","role":"supporting","firstAppearance":"s20","summary":"First mention: “Topsy”"},{"id":"missis","name":"Missis","role":"supporting","firstAppearance":"s3","summary":"First mention: “Missis is gone to spend the afternoon; so come into my little room, and we’ll have the time all to ourselves.””"},{"id":"sam","name":"Sam","role":"supporting","firstAppearance":"s6","summary":"First mention: “Black Sam, as he was commonly called, from his being about three shades blacker than any other son of ebony on the place, was revolving the matter profoundly in all its phases and bearings, with a comprehensiveness of…”"},{"id":"andy","name":"Andy","role":"supporting","firstAppearance":"s6","summary":"First mention: ““Andy,” said his mistress, “step to Eliza’s door, and tell her I have rung for her three times.”"},{"id":"mr-shelby","name":"Mr. Shelby","role":"supporting","firstAppearance":"s1","summary":"First mention: “His companion, Mr.”"},{"id":"mrs-shelby","name":"Mrs. Shelby","role":"supporting","firstAppearance":"s1","summary":"First mention: “Mrs.”"},{"id":"emmeline","name":"Emmeline","role":"supporting","firstAppearance":"s30","summary":"First mention: “These two, whom we shall call Susan and Emmeline, had been the personal attendants of an amiable and pious lady of New Orleans, by whom they had been carefully and piously instructed and trained.”"},{"id":"dinah","name":"Dinah","role":"supporting","firstAppearance":"s9","summary":"First mention: ““Sure, now, if she an’t a sight to behold!” said old Dinah, compassionately; “‘pears like ’t was the heat that made her faint.”"},{"id":"augustine","name":"Augustine","role":"supporting","firstAppearance":"s15","summary":"First mention: “The mother of Augustine was a Huguenot French lady, whose family had emigrated to Louisiana during the days of its early settlement.”"},{"id":"mas-r-george","name":"Mas’r George","role":"supporting","firstAppearance":"s4","summary":"First mention: “He was very busily intent at this moment on a slate lying before him, on which he was carefully and slowly endeavoring to accomplish a copy of some letters, in which operation he was overlooked by young Mas’r George,…”"},{"id":"mammy","name":"Mammy","role":"supporting","firstAppearance":"s15","summary":"First mention: ““O, there’s Mammy!”"},{"id":"marks","name":"Marks","role":"minor","firstAppearance":"s8","summary":"First mention: “The mousing man, who bore the name of Marks, instantly stopped his sipping, and, poking his head forward, looked shrewdly on the new acquaintance, as a cat sometimes looks at a moving dry leaf, or some other possible…”"},{"id":"phineas","name":"Phineas","role":"minor","firstAppearance":"s17","summary":"First mention: “Phineas was tall and lathy, red-haired, with an expression of great acuteness and shrewdness in his face.”"},{"id":"sambo","name":"Sambo","role":"minor","firstAppearance":"s30","summary":"First mention: “Sambo, I see!”"},{"id":"adolph","name":"Adolph","role":"minor","firstAppearance":"s15","summary":"First mention: ““Ah, Adolph, is it you?”"},{"id":"john","name":"John","role":"minor","firstAppearance":"s9","summary":"First mention: ““Now, John, I want to know if you think such a law as that is right and Christian?””"},{"id":"rachel","name":"Rachel","role":"minor","firstAppearance":"s12","summary":"First mention: ““In Ramah there was a voice heard,—weeping, and lamentation, and great mourning; Rachel weeping for her children, and would not be comforted.””"},{"id":"simeon","name":"Simeon","role":"minor","firstAppearance":"s13","summary":"First mention: ““Thank thee, Rachel; will see, tomorrow; but, here comes Simeon.””"},{"id":"miss-eva","name":"Miss Eva","role":"minor","firstAppearance":"s14","summary":"First mention: ““I don’t know, Miss Eva.””"},{"id":"rosa","name":"Rosa","role":"minor","firstAppearance":"s16","summary":"First mention: ““Why don’t you let Jane or Rosa take her place, a night or two,” said St.”"},{"id":"alfred","name":"Alfred","role":"minor","firstAppearance":"s19","summary":"First mention: “But mother did; and so, when I had quarreled with Alfred, and father looked sternly on me, I used to go off to mother’s room, and sit by her.”"},{"id":"mrs-bird","name":"Mrs. Bird","role":"minor","firstAppearance":"s9","summary":"First mention: “Mrs.”"},{"id":"mr-wilson","name":"Mr. Wilson","role":"minor","firstAppearance":"s11","summary":"First mention: “Mr.”"}],"relationships":[{"id":"r1","source":"mas-r-haley","target":"mr-shelby","weight":33,"phases":[{"at":"s1","type":"together","label":"Appear together","weight":10,"note":"First named together in Ch. 1."},{"at":"s4","type":"together","label":"Often together","weight":12}]},{"id":"r2","source":"mr-shelby","target":"tom-loker","weight":26,"phases":[{"at":"s1","type":"together","label":"Appear together","weight":8,"note":"First named together in Ch. 1."},{"at":"s5","type":"together","label":"Often together","weight":16}]},{"id":"r3","source":"mas-r-haley","target":"tom-loker","weight":74,"phases":[{"at":"s1","type":"together","label":"Appear together","weight":7,"note":"First named together in Ch. 1."},{"at":"s6","type":"together","label":"Often together","weight":12},{"at":"s8","type":"together","label":"Constantly together","weight":47}]},{"id":"r4","source":"eliza","target":"mr-shelby","weight":15,"phases":[{"at":"s1","type":"together","label":"Appear together","weight":1,"note":"First named together in Ch. 1."},{"at":"s6","type":"together","label":"Often together","weight":13}]},{"id":"r5","source":"eliza","target":"mrs-shelby","weight":17,"phases":[{"at":"s1","type":"together","label":"Appear together","weight":2,"note":"First named together in Ch. 1."},{"at":"s5","type":"together","label":"Often together","weight":14}]},{"id":"r6","source":"aunt-chloe","tar