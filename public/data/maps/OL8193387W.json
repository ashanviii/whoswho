{"schemaVersion":1,"workId":"OL8193387W","title":"Hard Times","authors":["Charles Dickens"],"firstPublished":1854,"edition":{"description":"Sections as detected in Project Gutenberg eBook #786.","source":"Project Gutenberg eBook #786","url":"https://www.gutenberg.org/ebooks/786"},"sectionLabel":{"singular":"Chapter","plural":"Chapters"},"sections":[{"id":"s1","label":"Ch. 1","title":"THE ONE THING NEEDFUL"},{"id":"s2","label":"Ch. 2","title":"MURDERING THE INNOCENTS"},{"id":"s3","label":"Ch. 3","title":"A LOOPHOLE"},{"id":"s4","label":"Ch. 4","title":"MR. BOUNDERBY"},{"id":"s5","label":"Ch. 5","title":"THE KEYNOTE"},{"id":"s6","label":"Ch. 6","title":"SLEARY’S HORSEMANSHIP"},{"id":"s7","label":"Ch. 7","title":"MRS. SPARSIT"},{"id":"s8","label":"Ch. 8","title":"NEVER WONDER"},{"id":"s9","label":"Ch. 9","title":"SISSY’S PROGRESS"},{"id":"s10","label":"Ch. 10","title":"STEPHEN BLACKPOOL"},{"id":"s11","label":"Ch. 11","title":"NO WAY OUT"},{"id":"s12","label":"Ch. 12","title":"THE OLD WOMAN"},{"id":"s13","label":"Ch. 13","title":"RACHAEL"},{"id":"s14","label":"Ch. 14","title":"THE GREAT MANUFACTURER"},{"id":"s15","label":"Ch. 15","title":"FATHER AND DAUGHTER"},{"id":"s16","label":"Ch. 16","title":"HUSBAND AND WIFE"},{"id":"s17","label":"Ch. 1","title":"EFFECTS IN THE BANK"},{"id":"s18","label":"Ch. 2","title":"MR. JAMES HARTHOUSE"},{"id":"s19","label":"Ch. 3","title":"THE WHELP"},{"id":"s20","label":"Ch. 4","title":"MEN AND BROTHERS"},{"id":"s21","label":"Ch. 5","title":"MEN AND MASTERS"},{"id":"s22","label":"Ch. 6","title":"FADING AWAY"},{"id":"s23","label":"Ch. 7","title":"GUNPOWDER"},{"id":"s24","label":"Ch. 8","title":"EXPLOSION"},{"id":"s25","label":"Ch. 9","title":"HEARING THE LAST OF IT"},{"id":"s26","label":"Ch. 10","title":"MRS. SPARSIT’S STAIRCASE"},{"id":"s27","label":"Ch. 11","title":"LOWER AND LOWER"},{"id":"s28","label":"Ch. 12","title":"DOWN"},{"id":"s29","label":"Ch. 1","title":"ANOTHER THING NEEDFUL"},{"id":"s30","label":"Ch. 2","title":"VERY RIDICULOUS"},{"id":"s31","label":"Ch. 3","title":"VERY DECIDED"},{"id":"s32","label":"Ch. 4","title":"LOST"},{"id":"s33","label":"Ch. 5","title":"FOUND"},{"id":"s34","label":"Ch. 6","title":"THE STARLIGHT"},{"id":"s35","label":"Ch. 7","title":"WHELP-HUNTING"},{"id":"s36","label":"Ch. 8","title":"PHILOSOPHICAL"},{"id":"s37","label":"Ch. 9","title":"FINAL"}],"groups":[{"id":"g-bounderby","label":"Bounderby (shared surname)"},{"id":"g-gradgrind","label":"Gradgrind (shared surname)"},{"id":"g-jupe","label":"Jupe (shared surname)"}],"characters":[{"id":"mr-bounderby","name":"Mr. Bounderby","aliases":["Bounderby"],"role":"protagonist","group":"g-bounderby","firstAppearance":"s3","summary":"First mention: “What would Mr.”"},{"id":"mrs-sparsit","name":"Mrs. Sparsit","aliases":["Sparsit"],"role":"protagonist","firstAppearance":"s7","summary":"First mention: “Mrs.”"},{"id":"louisa","name":"Louisa","role":"major","firstAppearance":"s3","summary":"First mention: “Phenomenon almost incredible though distinctly seen, what did he then behold but his own metallurgical Louisa, peeping with all her might through a hole in a deal board, and his own mathematical Thomas abasing himself…”"},{"id":"tom","name":"Tom","role":"major","firstAppearance":"s4","summary":"First mention: “‘You may cut the piece out with your penknife if you like, Tom.”"},{"id":"mr-gradgrind","name":"Mr. Gradgrind","role":"major","group":"g-gradgrind","firstAppearance":"s2","summary":"First mention: “In such terms Mr.”"},{"id":"stephen-blackpool","name":"Stephen Blackpool","aliases":["Stephen"],"role":"major","firstAppearance":"s10","summary":"First mention: “In the hardest working part of Coketown; in the innermost fortifications of that ugly citadel, where Nature was as strongly bricked out as killing airs and gases were bricked in; at the heart of the labyrinth of narro…”"},{"id":"rachael","name":"Rachael","role":"major","firstAppearance":"s10","summary":"First mention: “‘Yet I don’t see Rachael, still!”"},{"id":"sissy-jupe","name":"Sissy Jupe","aliases":["Sissy"],"role":"major","group":"g-jupe","firstAppearance":"s2","summary":"First mention: “‘Sissy Jupe, sir,’ explained number twenty, blushing, standing up, and curtseying.”"},{"id":"james-harthouse","name":"James Harthouse","aliases":["Mr. Harthouse","Mr. James Harthouse"],"role":"major","firstAppearance":"s18","summary":"First mention: “Specially to introduce James Harthouse, Esquire.”"},{"id":"bitzer","name":"Bitzer","role":"supporting","firstAppearance":"s2","summary":"First mention: “Bitzer, yours.’”"},{"id":"thomas-gradgrind","name":"Thomas Gradgrind","aliases":["Thomas","Mr. Thomas"],"role":"supporting","group":"g-gradgrind","firstAppearance":"s2","summary":"First mention: “Thomas Gradgrind, sir—peremptorily Thomas—Thomas Gradgrind.”"},{"id":"tom-gradgrind","name":"Tom Gradgrind","aliases":["Mr. Tom"],"role":"supporting","group":"g-gradgrind","firstAppearance":"s7","summary":"First mention: “‘Why, ma’am,’ he returned, ‘I am thinking about Tom Gradgrind’s whim;’ Tom Gradgrind, for a bluff independent manner of speaking—as if somebody were always endeavouring to bribe him with immense sums to say Thomas, an…”"},{"id":"mrs-gradgrind","name":"Mrs. Gradgrind","role":"supporting","group":"g-gradgrind","firstAppearance":"s4","summary":"First mention: “Bounderby delivered some observations to Mrs.”"},{"id":"bank","name":"Bank","role":"supporting","firstAppearance":"s14","summary":"First mention: “They are having a regular confab together up at the Bank.”"},{"id":"josiah-bounderby","name":"Josiah Bounderby","aliases":["Josiah"],"role":"supporting","group":"g-bounderby","firstAppearance":"s4","summary":"First mention: “Vagabond, errand-boy, vagabond, labourer, porter, clerk, chief manager, small partner, Josiah Bounderby of Coketown.”"},{"id":"mr-sleary","name":"Mr. Sleary","role":"supporting","firstAppearance":"s6","summary":"First mention: “Last of all appeared Mr.”"},{"id":"mrs-bounderby","name":"Mrs. Bounderby","role":"minor","group":"g-bounderby","firstAppearance":"s15","summary":"First mention: “Gradgrind,’ said her husband, who had waited for the achievement of this feat with some impatience, ‘allow me to present to you Mrs.”"},{"id":"mr-childers","name":"Childers","aliases":["Mr. Childers"],"role":"minor","firstAppearance":"s6","summary":"First mention: “Childers, so justly celebrated for his daring vaulting act as the Wild Huntsman of the North American Prairies; in which popular performance, a diminutive boy with an old face, who now accompanied him, assisted as his…”"},{"id":"mrs-pegler","name":"Mrs. Pegler","role":"minor","firstAppearance":"s22","summary":"First mention: “The old lady announced herself as ‘Mrs.”"},{"id":"choakumchild","name":"Choakumchild","role":"minor","firstAppearance":"s2","summary":"First mention: “M’Choakumchild,’ said the gentleman, ‘will proceed to give his first lesson here, Mr.”"},{"id":"miss-gradgrind","name":"Miss Gradgrind","role":"minor","group":"g-gradgrind","firstAppearance":"s7","summary":"First mention: “‘Are you speaking of young Miss Gradgrind, Mr.”"},{"id":"miss-louisa","name":"Miss Louisa","role":"minor","firstAppearance":"s7","summary":"First mention: “I have explained to Miss Louisa—this is Miss Louisa—the miserable but natural end of your late career; and you are to expressly understand that the whole of that subject is past, and is not to be referred to any more.”"},{"id":"merrylegs","name":"Merrylegs","role":"minor","firstAppearance":"s3","summary":"First mention: “Among the other pleasing but always strictly moral wonders which must be seen to be believed, Signor Jupe was that afternoon to ‘elucidate the diverting accomplishments of his highly trained performing dog Merrylegs.”"},{"id":"jem","name":"Jem","role":"minor","firstAppearance":"s18","summary":"First mention: “To whom this honourable and jocular, member fraternally said one day, ‘Jem, there’s a good opening among the hard Fact fellows, and they want men.”"},{"id":"master-kidderminster","name":"Master Kidderminster","role":"minor","firstAppearance":"s6","summary":"First mention: “(Master Kidderminster was Cupid’s mortal name.)”"},{"id":"lady-scadgers","name":"Lady Scadgers","role":"minor","firstAppearance":"s7","summary":"First mention: “She had a great aunt living in these very times called Lady Scadgers.”"},{"id":"powler","name":"Powler","role":"minor","firstAppearance":"s7","summary":"First mention: “Sparsit still called ‘a Powler.”"},{"id":"shaft","name":"Shaft","role":"minor","firstAppearance":"s34","summary":"First mention: “One of the men was in a drunken slumber, but on his comrade’s shouting to him that a man had fallen down the Old Hell Shaft, he started out to a pool of dirty water, put his head in it, and came back sober.”"},{"id":"cecilia-jupe","name":"Cecilia Jupe","role":"minor","group":"g-jupe","firstAppearance":"s2","summary":"First mention: “Cecilia Jupe.”"},{"id":"cupid","name":"Cupid","role":"minor","firstAppearance":"s6","summary":"First mention: “Made up with curls, wreaths, wings, white bismuth, and carmine, this hopeful young person soared into so pleasing a Cupid as to constitute the chief delight of the maternal part of the spectators; but in private, wher…”"},{"id":"nickits","name":"Nickits","role":"minor","firstAppearance":"s23","summary":"First mention: “‘Why, sir,’ he would say to a visitor, ‘I am told that Nickits,’ the late owner, ‘gave seven hundred pound for that Seabeach.”"},{"id":"childerth","name":"Childerth","role":"minor","firstAppearance":"s35","summary":"First mention: “Childerth, and thee hath got a boy, and though he’th only three yearth old, he thtickth on to any pony you can bring againtht him.”"}],"relationships":[{"id":"r1","source":"mr-gradgrind","target":"thomas-gradgrind","weight":21,"phases":[{"at":"s2","type":"together","label":"Appear together","weight":3,"note":"First named together in Ch. 2."},{"at":"s4","type":"together","label":"Often together","weight":14}]},{"id":"r2","source":"mr-gr