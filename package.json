{
  "name": "character-chart",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive book character relationship explorer",
  "scripts": {
    "dev": "vite",
    "build": "npm run data:validate && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "data:catalog": "tsx scripts/fetch-catalog.ts",
    "data:auto": "tsx scripts/auto-maps.ts",
    "data:wikidata": "tsx scripts/wikidata-index.ts",
    "data:validate": "tsx scripts/validate-maps.ts",
    "data:build": "tsx scripts/build-data.ts",
    "data:sql": "tsx scripts/export-sql.ts",
    "data:new-map": "tsx scripts/new-map.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "cytoscape": "^3.34.4",
    "cytoscape-fcose": "^2.2.0",
    "lucide-react": "^1.60.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "compromise": "^14.19.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
